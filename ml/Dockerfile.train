# ═══════════════════════════════════════════════════════════════════════
# CashGuard — Docker-контейнер для дообучения Qwen2.5-VL-7B (LoRA / QLoRA)
# ═══════════════════════════════════════════════════════════════════════
FROM pytorch/pytorch:2.4.0-cuda12.1-cudnn9-devel

ENV DEBIAN_FRONTEND=noninteractive
ENV PYTHONUNBUFFERED=1
ENV PIP_NO_CACHE_DIR=1

RUN apt-get update && apt-get install -y --no-install-recommends \
    git \
    curl \
    ffmpeg \
    libgl1 \
    libglib2.0-0 \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# Установка LLaMA-Factory и зависимостей для Vision-Language моделей
RUN pip install --no-cache-dir \
    "transformers>=4.45.0" \
    "accelerate>=0.34.0" \
    "peft>=0.12.0" \
    "bitsandbytes>=0.43.0" \
    "qwen-vl-utils" \
    "torchvision" \
    "llamafactory[torch,metrics]>=0.9.1"

WORKDIR /app/ml

# Точка входа — запуск обучения train_qlora.yaml
CMD ["bash", "train.sh", "train_qlora.yaml"]
